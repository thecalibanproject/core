{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliban.local/schemas/node.schema.json",
  "title": "Caliban Node spec (v0)",
  "description": "A node is a versioned, declarative AI sub-app. See docs/research/04-agent-orchestration.md §1.",
  "type": "object",
  "required": ["kind", "prompt", "model_policy", "budgets"],
  "additionalProperties": false,
  "properties": {
    "kind": { "enum": ["agent", "workflow"] },
    "description": { "type": "string" },
    "prompt": {
      "type": "object",
      "required": ["system"],
      "properties": {
        "system": { "type": "string" },
        "input_schema": { "type": "object", "description": "Validated against the run input (JSON Schema subset, see crates/caliban-nodes/src/schema.rs)" },
        "output_schema": { "type": "object", "description": "Validated against the run output (JSON Schema subset)" }
      }
    },
    "model_policy": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "description": "Model id (or caliban/auto) the node's calls ask for; default: the first candidate that is a model id, else caliban/auto" },
        "intent_classes": { "type": "array", "items": { "type": "string" } },
        "candidates": { "type": "array", "items": { "type": "string" }, "description": "Model ids or tiers (tier:small, tier:frontier)" },
        "escalate_on": { "type": "array", "items": { "enum": ["schema_violation", "low_confidence", "tool_error"] } },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "min_trust_tier": { "enum": ["t0_sovereign", "t1_attested", "t2_contracted", "t3_public"] }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "effect"],
        "properties": {
          "ref": { "type": "string", "pattern": "^(mcp|node)://", "description": "mcp://server/tool#sha256:<hash> or node://name@vN" },
          "effect": { "enum": ["read", "write"] },
          "requires": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "datasources": {
      "type": "object",
      "properties": { "scopes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_*]+:(read|write)$" } } }
    },
    "memory": {
      "type": "object",
      "properties": {
        "short_term": { "enum": ["none", "run"] },
        "long_term": { "type": "object", "properties": { "scope": { "enum": ["end_user", "tenant"] }, "ttl_days": { "type": "integer" } } }
      }
    },
    "guardrails": {
      "type": "object",
      "properties": {
        "pii": { "enum": ["off", "mask", "reversible"] },
        "injection_mode": { "enum": ["none", "plan_then_execute", "camel"] },
        "egress": { "type": "array", "items": { "type": "string" } }
      }
    },
    "agent": {
      "type": "object",
      "description": "Only for kind=agent: the bounded tool loop.",
      "properties": { "max_turns": { "type": "integer", "minimum": 1, "description": "Model turns at most (default: budgets.steps)" } }
    },
    "budgets": {
      "type": "object",
      "required": ["steps", "tokens", "wall_clock_s"],
      "properties": {
        "steps": { "type": "integer", "minimum": 1, "maximum": 200 },
        "depth": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
        "fanout": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8 },
        "tokens": { "type": "integer", "minimum": 1 },
        "wall_clock_s": { "type": "integer", "minimum": 1 }
      }
    },
    "exposure": {
      "type": "object",
      "properties": { "http": { "type": "boolean" }, "mcp_tool": { "type": "boolean" }, "a2a_agent": { "type": "boolean" } }
    },
    "graph": {
      "type": "object",
      "description": "Only for kind=workflow. Vertices + edges; loops must declare max_iterations. See docs/nodes.md for each vertex type's config.",
      "properties": {
        "entry": { "type": "string", "description": "The vertex a run starts at (default: the first)" },
        "vertices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "enum": ["llm", "tool", "router", "map", "reduce", "verify", "human", "subnode", "code"], "description": "code is not yet supported (refused at publish)" },
              "config": { "type": "object" },
              "max_iterations": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "when": { "type": "string" } } }
        }
      }
    },
    "eval": {
      "type": "object",
      "properties": { "suite": { "type": "string" }, "metrics": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
